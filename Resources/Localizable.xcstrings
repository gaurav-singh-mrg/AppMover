      }
    },
    "Symlink does not resolve: %@" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Symbolischer Link führt ins Leere: %@"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El enlace simbólico no apunta a nada: %@"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le lien symbolique ne mène nulle part : %@"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "シンボリックリンクの参照先がありません：%@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "符号链接无法解析：%@"
          }
        }
      }
    },
    "The apps themselves. Disconnecting the drive makes them disappear, not just fail." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Apps selbst. Wird das Laufwerk getrennt, verschwinden sie, statt nur nicht zu funktionieren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las propias apps. Al desconectar el disco desaparecen, no solo dejan de funcionar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les apps elles-mêmes. Déconnecter le disque les fait disparaître, pas seulement échouer."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリ本体です。ドライブを取り外すと、動作しなくなるだけでなくアプリそのものが見えなくなります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "应用本身。断开驱动器后，它们会直接消失，而不只是无法运行。"
          }
        }
      }
    },
    "The folder name on the drive cannot contain \"..\" or \".\"." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Ordnername auf dem Laufwerk darf nicht „..“ oder „.“ enthalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El nombre de la carpeta en el disco no puede contener “..” ni “.”."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le nom du dossier sur le disque ne peut pas contenir « .. » ni « . »."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ドライブ上のフォルダ名に「..」や「.」は使用できません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "驱动器上的文件夹名称不能包含“..”或“.”。"
          }
        }
      }
    },
    "This drive writes at %@, well below your internal SSD. Best for archives and apps you rarely open. Avoid moving Caches here -- they are read constantly, so a slow drive makes every app that uses them feel sluggish." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Laufwerk schreibt mit %@, weit unter Ihrer internen SSD. Am besten für Archive und selten geöffnete Apps. Verschieben Sie keine Caches hierher – sie werden ständig gelesen, daher fühlt sich jede App, die sie nutzt, auf einem langsamen Laufwerk träge an."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este disco escribe a %@, muy por debajo de tu SSD interno. Es ideal para archivos y apps que abres poco. Evita mover aquí las Caches: se leen constantemente, así que un disco lento hace que todas las apps que las usan vayan lentas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce disque écrit à %@, bien en dessous de votre SSD interne. Idéal pour les archives et les apps que vous ouvrez rarement. Évitez d’y déplacer les Caches : ils sont lus en permanence, et un disque lent ralentit toutes les apps qui les utilisent."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このドライブの書き込み速度は %@ で、内蔵 SSD を大きく下回ります。アーカイブやあまり開かないアプリに最適です。Caches はここに移動しないでください。常に読み込まれるため、低速なドライブでは Caches を使うすべてのアプリの動作が重くなります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此驱动器的写入速度为 %@，远低于内置 SSD。最适合存放归档和很少打开的应用。避免将 Caches 移到这里 — 它们会被频繁读取，驱动器较慢会让所有使用它们的应用变得迟缓。"
          }
        }
      }
    },
