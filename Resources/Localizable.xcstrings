    "%@ Your data is safe at %@ -- rename it back to %@." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ Ihre Daten sind sicher unter %2$@ – benennen Sie sie wieder in %3$@ um."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ Your data is safe at %2$@ -- rename it back to %3$@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ Tus datos están a salvo en %2$@: vuelve a cambiarles el nombre a %3$@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ Vos données sont en sécurité dans %2$@ — renommez-les en %3$@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ データは %2$@ に安全に残っています。名前を %3$@ に戻してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 你的数据安全地保存在 %2$@ — 请将其重命名回 %3$@。"
          }
        }
      }
    },
    "%@ differs from the startup disk in case sensitivity, which breaks apps subtly." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ unterscheidet sich vom Startvolume bei der Groß-/Kleinschreibung, was Apps auf subtile Weise stört."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ difiere del disco de arranque en la distinción entre mayúsculas y minúsculas, lo que provoca fallos sutiles en las apps."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ne gère pas la casse comme le disque de démarrage, ce qui perturbe les apps de façon subtile."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ は大文字と小文字の区別が起動ディスクと異なるため、アプリが気付きにくい形で正しく動作しなくなります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 与启动磁盘的大小写敏感设置不同，这会以不易察觉的方式破坏应用。"
          }
        }
      }
    },
    "%@ does not support symbolic links. Reformat as APFS." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ unterstützt keine symbolischen Links. Formatieren Sie es als APFS."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ no admite enlaces simbólicos. Formatéalo como APFS."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ne prend pas en charge les liens symboliques. Reformatez-le en APFS."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ はシンボリックリンクに対応していません。APFS でフォーマットし直してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 不支持符号链接。请将其重新格式化为 APFS。"
          }
        }
      }
    },
    "%@ free" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ frei"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ libres"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ disponibles"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "空き %@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可用 %@"
          }
        }
      }
    },
    "%@ is linked and in use — the copy on the drive is not abandoned." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ist verknüpft und in Gebrauch – die Kopie auf dem Laufwerk ist nicht verwaist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ está enlazado y en uso: la copia del disco no está abandonada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ est lié et en cours d’utilisation — la copie sur le disque n’est pas abandonnée."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ はリンクされていて使用中です。ドライブ上のコピーは放置されたものではありません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 已链接且正在使用 — 驱动器上的副本并未被遗弃。"
          }
        }
      }
    },
    "%@ is managed by macOS and cannot be relocated safely." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ wird von macOS verwaltet und kann nicht sicher verschoben werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ lo gestiona macOS y no se puede trasladar de forma segura."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ est géré par macOS et ne peut pas être déplacé en toute sécurité."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ は macOS によって管理されているため、安全に移動できません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 由 macOS 管理，无法安全移动。"
          }
        }
      }
    },
    "%@ is no longer connected." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ist nicht mehr angeschlossen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ya no está conectado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ n’est plus connecté."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ は接続されていません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 已断开连接。"
          }
        }
      }
    },
    "%@ is not in a folder AppMover manages." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ liegt nicht in einem Ordner, den AppMover verwaltet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ no está en una carpeta que gestione AppMover."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ne se trouve pas dans un dossier géré par AppMover."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ は AppMover が管理するフォルダにありません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 不在 AppMover 管理的文件夹中。"
          }
        }
      }
    },
    "%@ is protected by macOS and cannot be moved." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ist durch macOS geschützt und kann nicht verschoben werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ está protegido por macOS y no se puede mover."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ est protégé par macOS et ne peut pas être déplacé."
          }
