    "%lld recovered folders are waiting. Their apps cannot see them until you rename them back, dropping the \".appmover.bak\" or \".appmover.restore\" suffix." : {
      "localizations" : {
        "de" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld wiederhergestellter Ordner wartet. Die zugehörige App sieht ihn erst, wenn Sie ihn zurückbenennen und die Endung „.appmover.bak“ oder „.appmover.restore“ entfernen."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld wiederhergestellte Ordner warten. Die zugehörigen Apps sehen sie erst, wenn Sie sie zurückbenennen und die Endung „.appmover.bak“ oder „.appmover.restore“ entfernen."
                }
              }
            }
          }
        },
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld recovered folder is waiting. Its app cannot see it until you rename it back, dropping the \".appmover.bak\" or \".appmover.restore\" suffix."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld recovered folders are waiting. Their apps cannot see them until you rename them back, dropping the \".appmover.bak\" or \".appmover.restore\" suffix."
                }
              }
            }
          }
        },
        "es" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld carpeta recuperada está esperando. Su app no puede verla hasta que le devuelvas su nombre quitando el sufijo “.appmover.bak” o “.appmover.restore”."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld carpetas recuperadas están esperando. Sus apps no pueden verlas hasta que les devuelvas su nombre quitando el sufijo “.appmover.bak” o “.appmover.restore”."
                }
              }
            }
          }
        },
        "fr" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld dossier récupéré est en attente. Son app ne peut pas le voir tant que vous ne l’avez pas renommé en retirant le suffixe « .appmover.bak » ou « .appmover.restore »."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld dossiers récupérés sont en attente. Leurs apps ne peuvent pas les voir tant que vous ne les avez pas renommés en retirant le suffixe « .appmover.bak » ou « .appmover.restore »."
                }
              }
            }
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "復元されたフォルダが %lld 個あります。名前から「.appmover.bak」または「.appmover.restore」を取り除いて元に戻すまで、アプリからは見えません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有 %lld 个已恢复的文件夹等待处理。在你去掉“.appmover.bak”或“.appmover.restore”后缀、将其改回原名之前，对应的应用无法看到它们。"
          }
        }
      }
    },
    "A previous move was interrupted" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein früheres Verschieben wurde unterbrochen"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se interrumpió un traslado anterior"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un déplacement précédent a été interrompu"
          }
        },
