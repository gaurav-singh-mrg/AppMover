    "%@: an abandoned copy from an earlier move is still on the drive. Open this row and choose Clean Up first." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: Eine verwaiste Kopie aus einem früheren Verschieben liegt noch auf dem Laufwerk. Öffnen Sie diese Zeile und wählen Sie zuerst „Aufräumen“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: todavía hay en el disco una copia abandonada de un traslado anterior. Abre esta fila y elige Limpiar primero."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ : une copie abandonnée d’un déplacement précédent se trouve encore sur le disque. Ouvrez cette ligne et choisissez d’abord Nettoyer."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@：以前の移動で放置されたコピーがドライブに残っています。この行を開いて、先に「クリーンアップ」を選択してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@：驱动器上仍有之前移动遗留的副本。请先展开此行并选择“清理”。"
          }
        }
      }
    },
    "%@: quit %@ first. Moving this folder while it is running would silently discard everything it writes from now until it quits." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@: Beenden Sie zuerst %2$@. Wird dieser Ordner verschoben, während die App läuft, geht alles, was sie ab jetzt bis zum Beenden schreibt, unbemerkt verloren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@: quit %2$@ first. Moving this folder while it is running would silently discard everything it writes from now until it quits."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@: cierra primero %2$@. Si mueves esta carpeta mientras se está ejecutando, se descartará sin aviso todo lo que escriba desde ahora hasta que se cierre."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ : quittez d’abord %2$@. Déplacer ce dossier pendant son exécution ferait perdre silencieusement tout ce qu’elle écrit d’ici à ce qu’elle soit quittée."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@：先に %2$@ を終了してください。実行中にこのフォルダを移動すると、終了するまでに書き込まれる内容がすべて警告なしに失われます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@：请先退出 %2$@。在其运行时移动此文件夹，会悄无声息地丢弃它从现在到退出为止写入的所有内容。"
          }
        }
      }
    },
