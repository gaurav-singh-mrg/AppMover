          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Certains ne vous appartiennent pas et nécessiteront un administrateur."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一部はあなたが所有していないため、管理者の認証が必要です。"
